{
  "name": "pos_system",
  "version": "1.0.0",
  "description": "POS system backend API built with Express.js.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test",
    "frontend:dev": "npm.cmd --prefix frontend run dev",
    "frontend:build": "npm.cmd --prefix frontend run build",
    "frontend:lint": "npm.cmd --prefix frontend run lint",
    "frontend:format": "npm.cmd --prefix frontend run format",
    "frontend:format:check": "npm.cmd --prefix frontend run format:check",
    "frontend:preview": "npm.cmd --prefix frontend run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshana12345/pos_system.git"
  },
  "keywords": [
    "pos",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Harshana12345/pos_system/issues"
  },
  "homepage": "https://github.com/Harshana12345/pos_system#readme"
}
