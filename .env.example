# Backend environment template
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_system
DB_USER=pos_user
DB_PASSWORD=change-me
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DATABASE_URL=postgres://pos_user:change-me@localhost:5432/pos_system

# JWT configuration
JWT_ACCESS_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Loyalty points
LOYALTY_POINTS_ENABLED=true
LOYALTY_SPEND_AMOUNT_PER_POINT=100
LOYALTY_POINTS_ROUNDING=floor
